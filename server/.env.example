# 仅占位值，复制为 .env 后按需修改；.env 已加入 .gitignore。
# 使用方式：set -a; source .env; set +a; ./gradlew bootRun
# 同一份文件也被 docker compose 读取，因此不要写 export 前缀。
# 所有敏感配置均来自环境变量，应用启动时会集中校验并快速失败。

REQORA_SERVER_PORT=8080

# ---- 数据库 ----
REQORA_DB_URL="jdbc:mysql://127.0.0.1:3306/reqora?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_0900_ai_ci&serverTimezone=Asia/Shanghai"
REQORA_DB_USER=reqora
REQORA_DB_PASSWORD=change-me
REQORA_DB_ROOT_PASSWORD=change-me-root

# ---- 安全 ----
# 生成：openssl rand -base64 48 （至少 32 字符）
REQORA_JWT_SECRET=replace-with-a-random-48-byte-secret
REQORA_ACCESS_TTL=15m
REQORA_REFRESH_TTL=7d

# ---- 跨域白名单（生产请改为真实前端源，禁止 *） ----
REQORA_CORS_ORIGINS="http://localhost:1420,http://localhost:5173,tauri://localhost,http://tauri.localhost"

# ---- 网页版文档站分享（可选） ----
# 同源部署（推荐）：先在项目根目录 `bun run build`，再执行 Gradle 构建，dist/ 会一起
# 打进 jar，由内嵌 Tomcat 在后端端口直接提供 /?doc=<token>，无需另起 Vite / Nginx。
# 此时留空即可，服务端按当前请求 origin 自动拼链接（并带 api 参数指向自身）；
# 要发给外部用户建议填公网可达地址。
# 跨源部署（SPA 单独托管）才需要填 SPA 地址，并把 api 参数写进去，例如：
# https://docs.example.com/?api=https%3A%2F%2Fapi.example.com
# 本地开发示例：http://localhost:1420/?api=http%3A%2F%2Flocalhost%3A8080
# 跨源时 REQORA_CORS_ORIGINS 要包含该 SPA 的源。
REQORA_DOC_SITE_URL=""
REQORA_DOC_SITE_MAX_BYTES=2097152

# ---- 初始超级管理员（仅首次启动创建） ----
REQORA_ADMIN_USERNAME=admin
REQORA_ADMIN_EMAIL=admin@example.com
REQORA_ADMIN_PASSWORD=change-me-admin
