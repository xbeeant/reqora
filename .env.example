# Reqora runtime + release configuration (read by the Rust process at startup,
# and by the Node release scripts in scripts/).
# Copy to .env / .env.production only if you need to override defaults;
# .env* (except this file) is gitignored. Never commit real secrets.
# Invalid values fail fast at startup instead of silently degrading.

# Per-request timeout, seconds. Allowed: 1..=300
REQORA_TIMEOUT_SECS=30

# Byte cap for SSE / NDJSON streaming reads. Allowed: 1024..=104857600
# (normal HTTP bodies are streamed to disk and no longer buffered in memory)
REQORA_MAX_RESPONSE_BYTES=10485760

# Inline response preview returned over IPC, bytes. Allowed: 1024..=8388608
REQORA_INLINE_BODY_BYTES=262144

# Per-response spool ceiling, bytes. Allowed: 1048576..=1073741824
REQORA_MAX_BODY_SPOOL_BYTES=268435456

# Maximum request body size, bytes. Allowed: 1024..=52428800
REQORA_MAX_REQUEST_BODY_BYTES=5242880

# Maximum persisted workspace snapshot, bytes. Allowed: 1024..=52428800
REQORA_MAX_WORKSPACE_BYTES=5242880

# Structured log verbosity: debug | info | warn | error
REQORA_LOG_LEVEL=info

# Collaboration backend address baked into desktop builds as the default.
# When unset (and not filled in Settings → 协作空间), collaboration entry
# points are DISABLED with a deployment hint — there is no example.com fallback.
# Users can override it in Settings. Must be a full http(s) URL; only local
# development may use http://localhost:<port>.
# REQORA_COLLAB_SERVER_URL=https://collab.example.com

# Public release base URL consumed by `bun run release` / `bun run update:pack`.
# The signed manifest's download url becomes
#   <base>/reqora-<version>-x64-update.zip
# and the client should check <base>/update.json via REQORA_UPDATE_MANIFEST_URL.
# MUST be HTTPS: the updater rejects plaintext download urls.
# REQORA_RELEASE_URL_BASE=https://downloads.example.com/reqora

# Signed update-manifest endpoint checked at startup and on demand.
# Optional: unset disables the update check. HTTPS is required (loopback http
# is allowed for local dev). The endpoint must serve an Ed25519 signature
# envelope produced by scripts/sign-update-manifest.mjs, NOT plain JSON.
# When REQORA_RELEASE_URL_BASE is set, this is usually <base>/update.json.
# REQORA_UPDATE_MANIFEST_URL=https://example.com/reqora/update.json

# Ed25519 public key used to verify that envelope (32 raw bytes, hex/base64).
# Unset = the key compiled into src-tauri/src/service/update.rs. `bun run release`
# derives it from the signing key and syncs both trust roots automatically.
# REQORA_UPDATE_PUBLIC_KEY=

# Master key for at-rest credential encryption (32 bytes as 64 hex chars).
# Unset = generated once into ~/.reqora/vault.key with 0600 permissions.
# Keep this stable: rotating it without re-encrypting makes old values unreadable.
# REQORA_VAULT_KEY=

# Signing seed for the release workflow / CLI signer. NEVER commit a real value.
# `bun run release` loads .env / .env.production automatically, then falls back
# to ~/.reqora/update-signing.key (auto-generated, 0600, on first release).
# CLI equivalent: bun run update:keygen / bun run release:sync-key
# REQORA_UPDATE_SIGNING_KEY=
